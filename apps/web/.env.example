# Scout Web App Environment Configuration
# Copy this to .env on your cloud server

# User Authentication
FUSION_USERNAME=your_username_here
FUSION_PASSWORD=your_secure_password_here

# Server Settings
FUSION_PORT=8080
FUSION_HOST=0.0.0.0
FUSION_DB_PATH=/data/fusion.db

# Background RSS & Monitor engine intervals (seconds)
FUSION_PULL_INTERVAL=1800
FUSION_PULL_TIMEOUT=30

# Security rate limits
FUSION_LOGIN_RATE_LIMIT=10
FUSION_LOGIN_WINDOW=60
FUSION_LOGIN_BLOCK=300

# Cloud Monitor (leave false for self-hosted 24/7 web app)
CLOUD_MONITOR_ENABLED=false
